# Copy to .env and fill in. Never commit .env: this repository is public.

# Anthropic API key, from https://platform.claude.com
ANTHROPIC_API_KEY=
# Model id from https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=claude-opus-5-5

# MongoDB, started by `docker compose up`
MONGODB_URI=mongodb://localhost:27017/probe-lab
# Optional: overrides the database named in MONGODB_URI.
MONGODB_DB_NAME=

# Langfuse Cloud, from your project's Settings > API Keys.
# EU region: https://cloud.langfuse.com, US region: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# PostHog, from your project's Settings > Project > Project API key.
# The project key is public by design (posthog-js ships it to every browser).
# The web app reads these two from this file as well.
# EU region: https://eu.i.posthog.com, US region: https://us.i.posthog.com
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# API server. A host's PORT variable wins over API_PORT.
API_PORT=3000
# Origins allowed by CORS, comma-separated.
WEB_ORIGIN=http://localhost:5173
# Optional: a header your host's proxy sets to the client's IP (x-real-ip on
# Railway). Rate limits key on it. Leave empty when nothing sits in front.
CLIENT_IP_HEADER=

# Web app, production builds only: where the API lives, for example
# https://your-api.up.railway.app. Leave empty locally, where Vite proxies to it.
VITE_API_URL=
