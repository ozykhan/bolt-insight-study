{
  "name": "probe-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @probe-lab/shared build && pnpm --recursive --parallel --stream dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --filter @probe-lab/shared build && pnpm --recursive typecheck",
    "test": "pnpm --filter @probe-lab/shared build && pnpm --recursive test",
    "test:e2e": "pnpm --filter @probe-lab/api test:e2e",
    "prompts:push": "pnpm --filter @probe-lab/api prompts:push",
    "evals": "pnpm --filter @probe-lab/shared build && pnpm --filter @probe-lab/api evals",
    "evals:report": "pnpm --filter @probe-lab/api evals:report"
  }
}
